<?xml version="1.0" encoding="utf-8"?>
<!--
    Readability scrim for the network player page.

    The cover fills the whole 378x496 panel, so title, quality and time text sit
    directly on photographic content. A three-stop vertical gradient darkens the
    top and bottom bands where all text and controls live while keeping the
    middle of the artwork visible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#d9000000"
        android:centerColor="#66000000"
        android:endColor="#e6000000"
        android:centerY="0.42"
        android:type="linear" />
</shape>
